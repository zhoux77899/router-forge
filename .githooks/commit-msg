#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  echo 'Usage: commit-msg <message-file>' >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  echo 'Commit validation requires Node.js >=22.12.0 and npm. See CONTRIBUTING.md.' >&2
  exit 1
fi

if [ ! -f node_modules/@commitlint/cli/package.json ]; then
  echo 'Commit validation dependencies are missing. Run npm ci in the repository root.' >&2
  exit 1
fi

exec npm run --silent lint:commit -- "$1"
