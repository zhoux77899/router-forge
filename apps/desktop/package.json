  "dependencies": {
    "@router-forge/api": "workspace:*",
    "@router-forge/ui": "workspace:*",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@tanstack/react-query": "^5.90.5",
    "@hugeicons/react": "^1.1.10",
